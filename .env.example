# Copy this file to .env.local (for running on your computer) and fill in the values.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Never share or commit the real values.

# Your chosen passphrase (several words, e.g. "purple hammock eats seven mangoes")
APP_PASSCODE=

# A long random string used to sign the "remember this device" cookie.
SESSION_SECRET=

# Anthropic API key (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5
